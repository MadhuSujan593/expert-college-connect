generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model collegeprofile {
  id                String                         @id
  userId            String                         @unique(map: "CollegeProfile_userId_key")
  institutionName   String                         @db.VarChar(255)
  contactPersonName String                         @db.VarChar(255)
  institutionType   collegeprofile_institutionType @default(UNIVERSITY)
  accreditation     String?                        @db.VarChar(500)
  website           String?                        @db.VarChar(500)
  address           String?                        @db.Text
  city              String?                        @db.VarChar(100)
  state             String?                        @db.VarChar(100)
  country           String?                        @db.VarChar(100)
  postalCode        String?                        @db.VarChar(20)
  phone             String?                        @db.VarChar(20)
  isProfileComplete Boolean                        @default(false)
  isVerified        Boolean                        @default(false)
  verificationDate  DateTime?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime
  description       String?                        @db.Text
  logoUrl           String?                        @db.VarChar(500)
  user              user                           @relation(fields: [userId], references: [id], onDelete: Cascade, map: "CollegeProfile_userId_key")
  requirement       requirement[]

  @@index([city], map: "CollegeProfile_city_idx")
  @@index([country], map: "CollegeProfile_country_idx")
  @@index([institutionName], map: "CollegeProfile_institutionName_idx")
  @@index([isVerified], map: "CollegeProfile_isVerified_idx")
  @@index([state], map: "CollegeProfile_state_idx")
}

model emailverification {
  id        String    @id @default(cuid())
  userId    String?
  email     String    @db.VarChar(255)
  otp       String    @db.VarChar(10)
  expiresAt DateTime
  isUsed    Boolean   @default(false)
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  user      user?     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "EmailVerification_userId_fkey")

  @@index([email], map: "EmailVerification_email_idx")
  @@index([expiresAt], map: "EmailVerification_expiresAt_idx")
  @@index([isUsed], map: "EmailVerification_isUsed_idx")
  @@index([otp], map: "EmailVerification_otp_idx")
  @@index([userId], map: "EmailVerification_userId_idx")
}

model expertprofile {
  id                String           @id
  userId            String           @unique(map: "ExpertProfile_userId_key")
  jobTitle          String           @db.VarChar(255)
  company           String           @db.VarChar(255)
  experience        String?          @db.VarChar(100)
  location          String?          @db.VarChar(255)
  website           String?          @db.VarChar(500)
  primaryExpertise  String?          @db.VarChar(255)
  bio               String?          @db.Text
  hourlyRate        Decimal?         @db.Decimal(10, 2)
  availableFor      Json?
  preferredMode     String?          @db.VarChar(100)
  isProfileComplete Boolean          @default(false)
  isVerified        Boolean          @default(false)
  verificationDate  DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime
  resumeUrl         String?          @db.VarChar(500)
  profilePicture    String?          @db.VarChar(500)
  user              user             @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ExpertProfile_userId_fkey")
  expertskill       expertskill[]
  rating            rating[]
  service           service[]
  workexperience    workexperience[]

  @@index([hourlyRate], map: "ExpertProfile_hourlyRate_idx")
  @@index([isVerified], map: "ExpertProfile_isVerified_idx")
  @@index([location], map: "ExpertProfile_location_idx")
  @@index([primaryExpertise], map: "ExpertProfile_primaryExpertise_idx")
}

model expertskill {
  id              String                 @id
  expertProfileId String
  skillName       String                 @db.VarChar(255)
  skillLevel      expertskill_skillLevel @default(INTERMEDIATE)
  createdAt       DateTime               @default(now())
  expertprofile   expertprofile          @relation(fields: [expertProfileId], references: [id], onDelete: Cascade, map: "ExpertSkill_expertProfileId_fkey")

  @@index([expertProfileId], map: "ExpertSkill_expertProfileId_fkey")
  @@index([skillLevel], map: "ExpertSkill_skillLevel_idx")
  @@index([skillName], map: "ExpertSkill_skillName_idx")
}

model passwordreset {
  id        String    @id
  userId    String
  token     String    @unique(map: "PasswordReset_token_key") @db.VarChar(500)
  expiresAt DateTime
  isUsed    Boolean   @default(false)
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  user      user      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "PasswordReset_userId_fkey")

  @@index([expiresAt], map: "PasswordReset_expiresAt_idx")
  @@index([isUsed], map: "PasswordReset_isUsed_idx")
  @@index([token], map: "PasswordReset_token_idx")
  @@index([userId], map: "PasswordReset_userId_idx")
}

model payment {
  id            String                @id
  userId        String
  amount        Decimal               @db.Decimal(10, 2)
  currency      String                @default("USD") @db.VarChar(3)
  paymentMethod payment_paymentMethod
  status        payment_status        @default(PENDING)
  transactionId String?               @unique(map: "Payment_transactionId_key") @db.VarChar(255)
  description   String?               @db.Text
  metadata      Json?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime
  completedAt   DateTime?

  @@index([createdAt], map: "Payment_createdAt_idx")
  @@index([status], map: "Payment_status_idx")
  @@index([transactionId], map: "Payment_transactionId_idx")
  @@index([userId], map: "Payment_userId_idx")
}

model phoneverification {
  id        String    @id @default(cuid())
  userId    String?
  phone     String    @db.VarChar(20)
  otp       String    @db.VarChar(10)
  expiresAt DateTime
  isUsed    Boolean   @default(false)
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  user      user?     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "PhoneVerification_userId_fkey")

  @@index([expiresAt], map: "PhoneVerification_expiresAt_idx")
  @@index([isUsed], map: "PhoneVerification_isUsed_idx")
  @@index([otp], map: "PhoneVerification_otp_idx")
  @@index([phone], map: "PhoneVerification_phone_idx")
  @@index([userId], map: "PhoneVerification_userId_idx")
}

model rating {
  id               String        @id
  expertProfileId  String
  collegeProfileId String
  rating           Int
  review           String?       @db.Text
  isAnonymous      Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime
  expertprofile    expertprofile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade, map: "Rating_expertProfileId_fkey")

  @@index([collegeProfileId], map: "Rating_collegeProfileId_idx")
  @@index([createdAt], map: "Rating_createdAt_idx")
  @@index([expertProfileId], map: "Rating_expertProfileId_idx")
  @@index([rating], map: "Rating_rating_idx")
}

model refreshtoken {
  id        String   @id
  userId    String
  token     String   @unique(map: "RefreshToken_token_key") @db.VarChar(500)
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "RefreshToken_userId_fkey")

  @@index([expiresAt], map: "RefreshToken_expiresAt_idx")
  @@index([isRevoked], map: "RefreshToken_isRevoked_idx")
  @@index([token], map: "RefreshToken_token_idx")
  @@index([userId], map: "RefreshToken_userId_idx")
}

model requirement {
  id               String                 @id @default(cuid())
  collegeProfileId String
  title            String                 @db.VarChar(255)
  description      String                 @db.Text
  category         String                 @db.VarChar(100)
  subcategory      String?                @db.VarChar(100)
  budget           Decimal?               @db.Decimal(10, 2)
  budgetType       requirement_budgetType @default(FIXED)
  deadline         DateTime?
  isUrgent         Boolean                @default(false)
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime
  experience       String?                @db.Text
  requiredSkills   String?                @db.Text
  applications     application[]
  collegeprofile   collegeprofile         @relation(fields: [collegeProfileId], references: [id], onDelete: Cascade, map: "Requirement_collegeProfileId_fkey")

  @@index([budget], map: "Requirement_budget_idx")
  @@index([category], map: "Requirement_category_idx")
  @@index([collegeProfileId], map: "Requirement_collegeProfileId_idx")
  @@index([deadline], map: "Requirement_deadline_idx")
  @@index([isActive], map: "Requirement_isActive_idx")
  @@index([isUrgent], map: "Requirement_isUrgent_idx")
  @@index([subcategory], map: "Requirement_subcategory_idx")
}

model service {
  id              String            @id
  expertProfileId String
  title           String            @db.VarChar(255)
  description     String            @db.Text
  category        String            @db.VarChar(100)
  subcategory     String?           @db.VarChar(100)
  price           Decimal           @db.Decimal(10, 2)
  priceType       service_priceType @default(FIXED)
  duration        Int?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  expertprofile   expertprofile     @relation(fields: [expertProfileId], references: [id], onDelete: Cascade, map: "Service_expertProfileId_fkey")

  @@index([category], map: "Service_category_idx")
  @@index([expertProfileId], map: "Service_expertProfileId_idx")
  @@index([isActive], map: "Service_isActive_idx")
  @@index([price], map: "Service_price_idx")
  @@index([subcategory], map: "Service_subcategory_idx")
}

model session {
  id        String   @id
  userId    String
  token     String   @unique(map: "Session_token_key") @db.VarChar(500)
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  expiresAt DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Session_userId_fkey")

  @@index([expiresAt], map: "Session_expiresAt_idx")
  @@index([isActive], map: "Session_isActive_idx")
  @@index([token], map: "Session_token_idx")
  @@index([userId], map: "Session_userId_idx")
}

model user {
  id                String              @id
  email             String              @unique(map: "User_email_key") @db.VarChar(255)
  phone             String?             @unique(map: "User_phone_key") @db.VarChar(20)
  password          String              @db.VarChar(255)
  fullName          String              @db.VarChar(255)
  isEmailVerified   Boolean             @default(false)
  isPhoneVerified   Boolean             @default(false)
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  isActive          Boolean             @default(true)
  isDeleted         Boolean             @default(false)
  role              user_role           @default(USER)
  profileImage      String?             @db.VarChar(500)
  timezone          String?             @default("UTC") @db.VarChar(50)
  language          String?             @default("en") @db.VarChar(10)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  deletedAt         DateTime?
  applications      application[]
  collegeprofile    collegeprofile?
  emailverification emailverification[]
  expertprofile     expertprofile?
  receivedMessages  message[]           @relation("MessageReceiver")
  sentMessages      message[]           @relation("MessageSender")
  notifications     notification[]
  passwordreset     passwordreset[]
  phoneverification phoneverification[]
  refreshtoken      refreshtoken[]
  session           session[]

  @@index([createdAt], map: "User_createdAt_idx")
  @@index([email], map: "User_email_idx")
  @@index([isActive], map: "User_isActive_idx")
  @@index([phone], map: "User_phone_idx")
  @@index([role], map: "User_role_idx")
}

model workexperience {
  id              String        @id
  expertProfileId String
  jobTitle        String        @db.VarChar(255)
  company         String        @db.VarChar(255)
  location        String?       @db.VarChar(255)
  startDate       DateTime
  endDate         DateTime?
  isCurrent       Boolean       @default(false)
  description     String?       @db.Text
  skills          Json?
  achievements    String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  expertprofile   expertprofile @relation(fields: [expertProfileId], references: [id], onDelete: Cascade, map: "WorkExperience_expertProfileId_fkey")

  @@index([expertProfileId], map: "WorkExperience_expertProfileId_idx")
  @@index([startDate], map: "WorkExperience_startDate_idx")
  @@index([isCurrent], map: "WorkExperience_isCurrent_idx")
}

model application {
  id                 String             @id @default(cuid())
  requirementId      String
  expertId           String
  status             application_status @default(PENDING)
  coverLetter        String?            @db.Text
  proposedBudget     Decimal?           @db.Decimal(10, 2)
  proposedTimeline   String?            @db.VarChar(255)
  relevantExperience String?            @db.Text
  attachments        Json?
  isShortlisted      Boolean            @default(false)
  shortlistedAt      DateTime?
  reviewedAt         DateTime?
  reviewedBy         String?
  reviewNotes        String?            @db.Text
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  expert             user               @relation(fields: [expertId], references: [id], onDelete: Cascade)
  requirement        requirement        @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  notifications      notification[]

  @@index([requirementId], map: "Application_requirementId_idx")
  @@index([expertId], map: "Application_expertId_idx")
  @@index([status], map: "Application_status_idx")
  @@index([createdAt], map: "Application_createdAt_idx")
}

model notification {
  id            String            @id @default(cuid())
  userId        String
  applicationId String?
  type          notification_type
  title         String            @db.VarChar(255)
  message       String            @db.Text
  isRead        Boolean           @default(false)
  readAt        DateTime?
  createdAt     DateTime          @default(now())
  application   application?      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user          user              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Notification_userId_idx")
  @@index([applicationId], map: "Notification_applicationId_idx")
  @@index([isRead], map: "Notification_isRead_idx")
  @@index([createdAt], map: "Notification_createdAt_idx")
}

model message {
  id         String    @id @default(cuid())
  senderId   String
  receiverId String
  subject    String    @db.VarChar(255)
  content    String    @db.Text
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  receiver   user      @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     user      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId], map: "Message_senderId_idx")
  @@index([receiverId], map: "Message_receiverId_idx")
  @@index([isRead], map: "Message_isRead_idx")
  @@index([createdAt], map: "Message_createdAt_idx")
}

enum expertskill_skillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum collegeprofile_institutionType {
  UNIVERSITY
  COLLEGE
  INSTITUTE
  SCHOOL
  OTHER
}

enum payment_paymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  DIGITAL_WALLET
  CRYPTO
}

enum payment_status {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum requirement_budgetType {
  FIXED
  RANGE
  NEGOTIABLE
}

enum service_priceType {
  FIXED
  HOURLY
  DAILY
  NEGOTIABLE
}

enum user_role {
  USER
  EXPERT
  COLLEGE_ADMIN
  SUPER_ADMIN
}

enum application_status {
  PENDING
  SHORTLISTED
  REJECTED
  ACCEPTED
  WITHDRAWN
}

enum notification_type {
  APPLICATION_SUBMITTED
  APPLICATION_STATUS_UPDATED
  APPLICATION_SHORTLISTED
  APPLICATION_REJECTED
  APPLICATION_ACCEPTED
  MESSAGE_RECEIVED
  REQUIREMENT_POSTED
  REQUIREMENT_UPDATED
}
