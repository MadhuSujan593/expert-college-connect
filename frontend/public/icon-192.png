<svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Background circle with gradient -->
  <circle cx="32" cy="32" r="32" fill="url(#gradient)" />
  
  <!-- Graduation cap -->
  <path d="M16 24L32 16L48 24V32L32 40L16 32V24Z" fill="white" opacity="0.9"/>
  
  <!-- Tassel -->
  <path d="M32 16L36 12L32 8L28 12L32 16Z" fill="white" opacity="0.8"/>
  <line x1="32" y1="16" x2="32" y2="24" stroke="white" stroke-width="2" opacity="0.8"/>
  
  <!-- Connection lines -->
  <path d="M24 32C24 36 28 40 32 40C36 40 40 36 40 32" stroke="white" stroke-width="3" fill="none" opacity="0.7"/>
  
  <!-- Small dots representing connections -->
  <circle cx="24" cy="32" r="3" fill="white" opacity="0.8"/>
  <circle cx="40" cy="32" r="3" fill="white" opacity="0.8"/>
  <circle cx="32" cy="40" r="3" fill="white" opacity="0.8"/>
  
  <!-- Additional connection dots -->
  <circle cx="28" cy="28" r="2" fill="white" opacity="0.6"/>
  <circle cx="36" cy="28" r="2" fill="white" opacity="0.6"/>
  <circle cx="28" cy="36" r="2" fill="white" opacity="0.6"/>
  <circle cx="36" cy="36" r="2" fill="white" opacity="0.6"/>
  
  <!-- Gradient definition -->
  <defs>
    <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#4F46E5;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#7C3AED;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#06B6D4;stop-opacity:1" />
    </linearGradient>
  </defs>
</svg>
